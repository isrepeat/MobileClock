<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.example.mobileclock" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileClockUpdater">
        <activity
            android:name=".UpdaterActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTask"
            android:permission="com.example.mobileclock.permission.INSTALL_UPDATE"
            android:taskAffinity=""
            android:theme="@style/Theme.MobileClockUpdater">
            <intent-filter>
                <action android:name="com.example.mobileclock.updater.action.INSTALL_UPDATE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>
    </application>

</manifest>