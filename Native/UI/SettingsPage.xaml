<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="urn:mobileclock:xaml"
      id="settingsPage"
      background="#1B1C17"
      padding="24 24 80 24">
    <StackPanel orientation="Vertical"
                horizontalAlignment="Stretch"
                verticalAlignment="Top">
        <Grid height="90"
              borderBrush="#4E4B3D"
              borderThickness="0 0 0 1"
              horizontalAlignment="Stretch">
            <columnDefinitions>
                <columnDefinition width="12%" />
                <columnDefinition width="76%" />
                <columnDefinition width="12%" />
            </columnDefinitions>
            <Border id="backNavigation"
                    background="#292A23"
                    command="navigateToMain"
                    cornerRadius="24"
                    padding="10"
                    horizontalAlignment="Center"
                    verticalAlignment="Center">
                <SvgImage source="Icons/back.svg"
                          tint="#EADCB5"
                          width="40"
                          height="40"
                          horizontalAlignment="Center"
                          verticalAlignment="Center" />
            </Border>
            <TextBlock text="Настройки"
                       fontSize="40"
                       fontWeight="Bold"
                       foreground="#EADCB5"
                       horizontalAlignment="Center"
                       verticalAlignment="Center"
                       gridColumn="1" />
        </Grid>
        <TextBlock text="Оформление"
                   fontSize="18"
                   fontWeight="Bold"
                   foreground="#9D9477"
                   margin="8 36 0 12" />
        <Border background="#292A23"
                borderBrush="#4E4B3D"
                borderThickness="1"
                cornerRadius="16"
                padding="24"
                horizontalAlignment="Stretch">
            <Grid height="72"
                  horizontalAlignment="Stretch">
                <columnDefinitions>
                    <columnDefinition width="40%" />
                    <columnDefinition width="60%" />
                </columnDefinitions>
                <TextBlock text="Тема"
                           fontSize="24"
                           foreground="#EADCB5"
                           horizontalAlignment="Left"
                           verticalAlignment="Center" />
                <TextBlock text="{Binding Theme}"
                           fontSize="20"
                           foreground="#D5BD7D"
                           horizontalAlignment="Right"
                           verticalAlignment="Center"
                           gridColumn="1" />
            </Grid>
        </Border>
        <TextBlock text="Будильники"
                   fontSize="18"
                   fontWeight="Bold"
                   foreground="#9D9477"
                   margin="8 36 0 12" />
        <Border background="#292A23"
                borderBrush="#4E4B3D"
                borderThickness="1"
                cornerRadius="16"
                padding="24"
                horizontalAlignment="Stretch">
            <Grid height="72"
                  horizontalAlignment="Stretch">
                <columnDefinitions>
                    <columnDefinition width="40%" />
                    <columnDefinition width="60%" />
                </columnDefinitions>
                <TextBlock text="Звук"
                           fontSize="24"
                           foreground="#EADCB5"
                           horizontalAlignment="Left"
                           verticalAlignment="Center" />
                <TextBlock text="{Binding Sound}"
                           fontSize="20"
                           foreground="#D5BD7D"
                           horizontalAlignment="Right"
                           verticalAlignment="Center"
                           gridColumn="1" />
            </Grid>
        </Border>
        <Button id="shareLogsButton"
                text="Поделиться логом"
                command="shareLogs"
                background="#303128"
                borderBrush="#47483D"
                borderThickness="1"
                foreground="#F1E8D2"
                cornerRadius="16"
                fontSize="24"
                fontWeight="Bold"
                height="72"
                margin="0 0 0 10"
                contentAlignment="Center"
                horizontalAlignment="Stretch">
            <Button.Storyboards>
                <Storyboard trigger="PointerDown">
                    <RendererAnimation name="SoftPulse"
                                       from="0"
                                       to="1"
                                       duration="1000"
                                       easing="CubicOut"
                                       intensity="0.95"
                                       spread="1.5"
                                       fadeExponent="1.6" />
                    <FloatAnimation property="waveOpacity"
                                    from="0"
                                    to="1"
                                    duration="1"
                                    easing="Linear" />
                </Storyboard>
                <Storyboard trigger="PointerUp">
                    <FloatAnimation property="waveOpacity"
                                    from="Current"
                                    to="0"
                                    duration="280"
                                    easing="CubicOut" />
                </Storyboard>
            </Button.Storyboards>
        </Button>
        <Button id="exportLogsButton"
                text="Экспортировать логи"
                command="exportLogs"
                background="#303128"
                borderBrush="#47483D"
                borderThickness="1"
                foreground="#F1E8D2"
                cornerRadius="16"
                fontSize="24"
                fontWeight="Bold"
                height="72"
                margin="0 0 0 10"
                contentAlignment="Center"
                horizontalAlignment="Stretch">
            <Button.Storyboards>
                <Storyboard trigger="PointerDown">
                    <RendererAnimation name="SoftPulse"
                                       from="0"
                                       to="1"
                                       duration="1000"
                                       easing="CubicOut"
                                       intensity="0.95"
                                       spread="1.5"
                                       fadeExponent="1.6" />
                    <FloatAnimation property="waveOpacity"
                                    from="0"
                                    to="1"
                                    duration="1"
                                    easing="Linear" />
                </Storyboard>
                <Storyboard trigger="PointerUp">
                    <FloatAnimation property="waveOpacity"
                                    from="Current"
                                    to="0"
                                    duration="280"
                                    easing="CubicOut" />
                </Storyboard>
            </Button.Storyboards>
        </Button>
    </StackPanel>
</Page>