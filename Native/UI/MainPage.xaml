<Page id="root"
      borderThickness="0"
      background="#1B1C17"
      padding="24 24 80 24">
    <StackPanel id="alarmPage"
                borderThickness="0"
                orientation="Vertical"
                horizontalAlignment="Stretch"
                verticalAlignment="Top">
        <Grid id="pageHeader"
              background="#1B1C17"
              borderBrush="#4E4B3D"
              borderThickness="0 0 0 1"
              height="90"
              horizontalAlignment="Stretch">
            <columnDefinitions>
                <columnDefinition width="25%" />
                <columnDefinition width="59%" />
                <columnDefinition width="8%" />
                <columnDefinition width="8%" />
            </columnDefinitions>
            <TextBlock id="pageTitle"
                       text="Будильники"
                       fontSize="30"
                       fontWeight="Bold"
                       foreground="#EADCB5"
                       horizontalAlignment="Left"
                       verticalAlignment="Center" />
            <TextBlock id="packageVersion"
                       text="{Binding PackageVersion}"
                       fontSize="40"
                       fontWeight="Bold"
                       foreground="#9D9477"
                       horizontalAlignment="Center"
                       verticalAlignment="Center"
                       gridColumn="1" />
            <Border id="addAlarmButton"
                    background="#292A23"
                    cornerRadius="24"
                    padding="18 18 10 10"
                    horizontalAlignment="Center"
                    verticalAlignment="Center"
                    gridColumn="2">
                <SvgImage id="addAlarmIcon"
                          source="Icons/add.svg"
                          tint="#D5BD7D"
                          width="24"
                          height="24"
                          horizontalAlignment="Center"
                          verticalAlignment="Center" />
            </Border>
            <Border id="settingsButton"
                    background="#292A23"
                    cornerRadius="24"
                    padding="18 18 10 10"
                    horizontalAlignment="Center"
                    verticalAlignment="Center"
                    gridColumn="3">
                <SvgImage id="settingsNavigation"
                          source="Icons/settings.svg"
                          tint="#9D9477"
                          width="22"
                          height="22"
                          horizontalAlignment="Center"
                          verticalAlignment="Center" />
            </Border>
        </Grid>
        <StackPanel id="nextAlarmSummary"
                    height="120"
                    orientation="Vertical"
                    horizontalAlignment="Stretch">
            <TextBlock text="До ближайшего"
                       fontSize="16"
                       foreground="#9D9477"
                       horizontalAlignment="Center" />
            <TextBlock id="clockText"
                       text="{Binding ClockText}"
                       fontSize="44"
                       foreground="#EADCB5"
                       horizontalAlignment="Center" />
        </StackPanel>
        <Border id="alarmsCard"
                height="600"
                background="#22231E"
                cornerRadius="20"
                horizontalAlignment="Stretch"
                margin="14 14 0 0">
            <ListView id="alarms"
                      horizontalAlignment="Stretch"
                      itemsSource="{Binding Alarms}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid height="150"
                              horizontalAlignment="Stretch">
                            <TextBlock text="{Binding Time}"
                                       fontSize="42"
                                       foreground="#EADCB5"
                                       horizontalAlignment="Center"
                                       verticalAlignment="Center" />
                            <Grid horizontalAlignment="Stretch">
                                <columnDefinitions>
                                    <columnDefinition width="86%" />
                                    <columnDefinition width="14%" />
                                </columnDefinitions>
                                <ToggleSwitch height="42"
                                              background="#D5BD7D"
                                              borderBrush="#555447"
                                              foreground="#1B1C17"
                                              tint="#CFC29B"
                                              isOn="{Binding IsEnabled}"
                                              horizontalAlignment="Stretch"
                                              verticalAlignment="Center"
                                              gridColumn="1" />
                            </Grid>
                            <Border height="1"
                                    background="#4E4B3D"
                                    margin="0 0 10 10"
                                    horizontalAlignment="Stretch"
                                    verticalAlignment="Bottom" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <Grid id="pageFooter"
              background="#1B1C17"
              borderBrush="#4E4B3D"
              borderThickness="0 1 0 0"
              height="90"
              horizontalAlignment="Stretch"
              margin="0 0 14 0">
            <columnDefinitions>
                <columnDefinition width="33%" />
                <columnDefinition width="34%" />
                <columnDefinition width="33%" />
            </columnDefinitions>
            <TextBlock text="Будильники"
                       fontSize="13"
                       fontWeight="Bold"
                       foreground="#D5BD7D"
                       horizontalAlignment="Center"
                       verticalAlignment="Center" />
            <TextBlock text="Таймер"
                       fontSize="13"
                       foreground="#9D9477"
                       horizontalAlignment="Center"
                       verticalAlignment="Center"
                       gridColumn="1" />
            <TextBlock text="Секундомер"
                       fontSize="13"
                       foreground="#9D9477"
                       horizontalAlignment="Center"
                       verticalAlignment="Center"
                       gridColumn="2" />
        </Grid>
    </StackPanel>
</Page>