<Page id="root"
      borderThickness="0"
      background="#171813"
      padding="60 60 48 32">
    <StackPanel id="alarmPage"
                borderThickness="0"
                orientation="Vertical"
                horizontalAlignment="Stretch"
                verticalAlignment="Top">
        <Grid id="pageHeader"
              height="94"
              horizontalAlignment="Stretch">
            <columnDefinitions>
                <columnDefinition width="*" />
                <columnDefinition width="Auto" />
                <columnDefinition width="*" />
            </columnDefinitions>
            <TextBlock id="pageTitle"
                       text="Будильники"
                       fontSize="40"
                       fontWeight="Normal"
                       foreground="#F1E8D2"
                       horizontalAlignment="Left"
                       verticalAlignment="Center" />
            <StackPanel id="pageActions"
                        orientation="Horizontal"
                        horizontalAlignment="Right"
                        verticalAlignment="Center"
                        gridColumn="3">
                <Border id="addAlarmButton"
                        background="#2A2B24"
                        cornerRadius="20"
                        padding="16 16 12 12"
                        margin="0 16 0 0"
                        horizontalAlignment="Center"
                        verticalAlignment="Center">
                    <SvgImage id="addAlarmIcon"
                              source="Icons/add.svg"
                              tint="#E2C878"
                              width="40"
                              height="40"
                              horizontalAlignment="Center"
                              verticalAlignment="Center" />
                </Border>
                <Border id="settingsButton"
                        background="#2A2B24"
                        cornerRadius="20"
                        padding="16 16 12 12"
                        horizontalAlignment="Center"
                        verticalAlignment="Center">
                    <SvgImage id="settingsNavigation"
                              source="Icons/settings.svg"
                              tint="#F1E8D2"
                              width="40"
                              height="40"
                              horizontalAlignment="Center"
                              verticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>
        <StackPanel id="nextAlarmSummary"
                    height="94"
                    orientation="Vertical"
                    horizontalAlignment="Stretch">
            <TextBlock text="До ближайшего будильника"
                       fontSize="18"
                       foreground="#938E78"
                       horizontalAlignment="Center" />
            <TextBlock id="clockText"
                       text="{Binding ClockText}"
                       fontSize="40"
                       foreground="#E7D8AB"
                       horizontalAlignment="Center" />
        </StackPanel>
        <ListView id="alarms"
                  horizontalAlignment="Stretch"
                  itemsSource="{Binding Alarms}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border background="#22231D"
                            borderBrush="#32332B"
                            borderThickness="1"
                            cornerRadius="20"
                            margin="0 0 0 14"
                            padding="22 18 22 18"
                            horizontalAlignment="Stretch">
                        <Grid height="140"
                              horizontalAlignment="Stretch">
                            <columnDefinitions>
                                <columnDefinition width="80%" />
                                <columnDefinition width="*" />
                                <columnDefinition width="18%" />
                            </columnDefinitions>
                            <Grid horizontalAlignment="Stretch"
                                  verticalAlignment="Stretch">
                                <rowDefinitions>
                                    <rowDefinition height="75%" />
                                    <rowDefinition height="25%" />
                                </rowDefinitions>
                                <TextBlock text="{Binding Time}"
                                           fontSize="82"
                                           fontWeight="Bold"
                                           foreground="#F1E8D2"
                                           horizontalAlignment="Left"
                                           verticalAlignment="Center" />
                                <Border horizontalAlignment="Stretch"
                                        verticalAlignment="Top"
                                        gridRow="1">
                                    <TextBlock text="{Binding Repeat}"
                                               fontSize="38"
                                               foreground="#9E9985"
                                               horizontalAlignment="Left"
                                               verticalAlignment="Top" />
                                </Border>
                            </Grid>
                            <ToggleSwitch height="54"
                                          background="#E2C878"
                                          borderBrush="#555447"
                                          foreground="#171813"
                                          tint="#D8CC9C"
                                          isOn="{Binding IsEnabled}"
                                          horizontalAlignment="Stretch"
                                          verticalAlignment="Center"
                                          gridColumn="2" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid id="pageFooter"
              borderBrush="#34352D"
              borderThickness="0 1 0 0"
              height="116"
              horizontalAlignment="Stretch"
              margin="0 10 0 0">
            <columnDefinitions>
                <columnDefinition width="33%" />
                <columnDefinition width="34%" />
                <columnDefinition width="33%" />
            </columnDefinitions>
            <StackPanel orientation="Vertical"
                        horizontalAlignment="Center"
                        verticalAlignment="Center">
                <SvgImage source="Icons/alarm.svg"
                          tint="#E2C878"
                          width="28"
                          height="28"
                          horizontalAlignment="Center" />
                <TextBlock text="Будильники"
                           fontSize="20"
                           fontWeight="Bold"
                           foreground="#E2C878"
                           horizontalAlignment="Center" />
            </StackPanel>
            <StackPanel orientation="Vertical"
                        horizontalAlignment="Center"
                        verticalAlignment="Center"
                        gridColumn="1">
                <SvgImage source="Icons/timer.svg"
                          tint="#938E78"
                          width="28"
                          height="28"
                          horizontalAlignment="Center" />
                <TextBlock text="Таймер"
                           fontSize="20"
                           foreground="#938E78"
                           horizontalAlignment="Center" />
            </StackPanel>
            <StackPanel orientation="Vertical"
                        horizontalAlignment="Center"
                        verticalAlignment="Center"
                        gridColumn="2">
                <SvgImage source="Icons/stopwatch.svg"
                          tint="#938E78"
                          width="28"
                          height="28"
                          horizontalAlignment="Center" />
                <TextBlock text="Секундомер"
                           fontSize="20"
                           foreground="#938E78"
                           horizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>