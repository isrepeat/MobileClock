<Page id="root"
      background="#000000">
    <TextBlock id="clock"
               text="{Binding ClockText}"
               fontSize="64"
               foreground="#FFFFFF"
               verticalAlignment="Top" />
    <StackPanel orientation="Vertical"
                verticalAlignment="Center"
                horizontalAlignment="Center">
        <Border id="alarmCard"
                width="360"
                height="132"
                margin="0 0 0 16"
                background="#242424"
                cornerRadius="28" />
        <ToggleSwitch id="alarmEnabled"
                      width="300"
                      height="180"
                      isOn="{Binding IsAlarmEnabled, Mode=TwoWay}" />
    </StackPanel>
</Page>