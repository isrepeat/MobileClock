    "$interactions": {
      "alarmActionsMenu": {
        "tap": {
          "type": "toggle",
          "path": "IsAlarmActionsMenuVisible",
          "visualStateHost": "alarmActionsHost",
          "visualStateGroup": "AlarmActionsPanelStates",
          "visualStateTrue": "Expanded",
          "visualStateFalse": "Collapsed"
        }
      },
      "alarmActionsHandle": {
        "tap": {
          "type": "toggle",
          "path": "IsAlarmActionsMenuVisible",
          "previewElement": "alarmActionsPanel"
        }
      },
      "updateApplicationButton": {
        "tap": {
          "type": "set",
          "path": "Status",
          "value": "Обновление запущено"
        }
      },
      "uploadScreenshotButton": {
        "tap": {
