<?xml version="1.0" encoding="utf-8"?>
<?mobileclock-preview width="720" height="360"?>
<Page xmlns="urn:mobileclock:xaml"
      id="buttonPressExample"
      background="#181A15"
      padding="48">
    <StackPanel orientation="Vertical"
                horizontalAlignment="Center"
                verticalAlignment="Center">
        <TextBlock text="Удерживайте кнопку"
                   fontSize="28"
                   fontWeight="Bold"
                   foreground="#F1E8D2"
                   horizontalAlignment="Center"
                   margin="0 0 0 32" />
        <Button id="pressButton"
                text="Включить будильник"
                command="toggleAlarm"
                background="#303128"
                activeBackground="#E6CA69"
                borderBrush="#47483D"
                activeBorderBrush="#E6CA69"
                borderThickness="1"
                cornerRadius="14"
                padding="24 16 24 16"
                fontSize="18"
                fontWeight="Bold"
                foreground="#F1E8D2"
                activeForeground="#1C1C16"
                width="280"
                height="64"
                horizontalAlignment="Center" />
    </StackPanel>
</Page>