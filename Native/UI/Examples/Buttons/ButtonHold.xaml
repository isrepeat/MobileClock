<?xml version="1.0" encoding="utf-8"?>
<?mobileclock-preview width="400" height="300"?>
<Page xmlns="urn:mobileclock:xaml"
      id="buttonHoldExample"
      background="#181A15"
      padding="48">
    <StackPanel orientation="Vertical"
                horizontalAlignment="Center"
                verticalAlignment="Center">
        <TextBlock text="Удерживайте кнопку"
                   fontSize="28"
                   fontWeight="Bold"
                   foreground="#F1E8D2"
                   horizontalAlignment="Center"
                   margin="0 0 0 32" />
        <Button id="holdButton"
                text="Удерживать"
                command="hold"
                background="#303128"
                activeBackground="#E6CA69"
                borderBrush="#47483D"
                activeBorderBrush="#E6CA69"
                borderThickness="1"
                cornerRadius="14"
                padding="24 16 24 16"
                fontSize="18"
                fontWeight="Bold"
                foreground="#F1E8D2"
                activeForeground="#1C1C16"
                width="280"
                height="64"
                horizontalAlignment="Center">
            <Button.Storyboards>
                <Storyboard trigger="PointerDown">
                    <RendererAnimation name="SoftPulse"
                                       from="0"
                                       to="1"
                                       duration="650"
                                       easing="CubicOut"
                                       intensity="0.75"
                                       spread="0.36"
                                       fadeExponent="1.6" />
                    <FloatAnimation property="waveOpacity"
                                    from="0"
                                    to="1"
                                    duration="1"
                                    easing="Linear" />
                </Storyboard>
                <Storyboard trigger="PointerUp">
                    <FloatAnimation property="waveOpacity"
                                    from="Current"
                                    to="0"
                                    duration="280"
                                    easing="CubicOut" />
                </Storyboard>
            </Button.Storyboards>
        </Button>
    </StackPanel>
</Page>