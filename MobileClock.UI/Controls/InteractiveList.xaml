<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="mobileclock::ui::controls::InteractiveList"
             xmlns="urn:mobileclock:xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer id="interactiveListScrollViewer"
                  verticalAlignment="Stretch"
                  horizontalAlignment="Stretch"
                  verticalScrollBarVisibility="Auto">
        <ListView id="interactiveListItems"
                  verticalAlignment="Stretch"
                  horizontalAlignment="Stretch"
                  itemsSource="{Binding ItemsSource}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border id="interactiveListItem"
                            height="200"
                            margin="0 0 16 0"
                            verticalAlignment="Stretch"
                            horizontalAlignment="Stretch">
                        <Border id="interactiveListGestureTarget"
                                verticalAlignment="Stretch"
                                horizontalAlignment="Stretch"
                                command="{Binding AlarmBlockCommand}">
                            <Grid verticalAlignment="Stretch"
                                  horizontalAlignment="Stretch">
                                <columnDefinitions>
                                    <columnDefinition width="112"/>
                                    <columnDefinition width="80"/>
                                    <columnDefinition width="*"/>
                                </columnDefinitions>
                                <TextBlock gridColumn="0"
                                           verticalAlignment="Center"
                                           horizontalAlignment="Right"
                                           fontSize="48"
                                           foreground="#F1E8D2"
                                           text="{Binding Time}"/>
                                <Border gridColumn="1"
                                        width="36"
                                        height="36"
                                        verticalAlignment="Center"
                                        horizontalAlignment="Center"
                                        background="#171813"
                                        cornerRadius="18"
                                        borderBrush="#DDB54F"
                                        borderThickness="8"/>
                                <Grid gridColumn="2"
                                      margin="0 0 18 18"
                                      verticalAlignment="Stretch"
                                      horizontalAlignment="Stretch">
                                    <Border verticalAlignment="Stretch"
                                            horizontalAlignment="Stretch"
                                            background="#22231B"
                                            cornerRadius="22"
                                            borderBrush="#292A20"
                                            borderThickness="1"/>
                                    <Grid margin="30 28 24 24"
                                          verticalAlignment="Stretch"
                                          horizontalAlignment="Stretch">
                                        <columnDefinitions>
                                            <columnDefinition width="*"/>
                                            <columnDefinition width="84"/>
                                        </columnDefinitions>
                                        <StackPanel verticalAlignment="Center"
                                                    horizontalAlignment="Left"
                                                    orientation="Vertical">
                                            <Border width="134"
                                                    height="14"
                                                    margin="0 0 0 30"
                                                    background="#5F5D43"
                                                    cornerRadius="7"/>
                                            <Border width="78"
                                                    height="12"
                                                    horizontalAlignment="Left"
                                                    background="#4D4C36"
                                                    cornerRadius="6"/>
                                        </StackPanel>
                                        <ToggleSwitch gridColumn="1"
                                                      width="84"
                                                      height="48"
                                                      verticalAlignment="Center"
                                                      horizontalAlignment="Right"
                                                      foreground="#F1E8D2"
                                                      background="#E5BD59"
                                                      borderBrush="#494938"
                                                      tint="#A5A38C"
                                                      command="{Binding ToggleAlarmCommand}"
                                                      isOn="{Binding IsEnabled}">
                                            <ToggleSwitch.Storyboards>
                                                <Storyboard trigger="Toggled">
                                                    <FloatAnimation property="toggleProgress"
                                                                    from="Current"
                                                                    to="ToggleState"
                                                                    duration="220"
                                                                    easing="CubicOut"/>
                                                </Storyboard>
                                            </ToggleSwitch.Storyboards>
                                        </ToggleSwitch>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </ScrollViewer>
</UserControl>