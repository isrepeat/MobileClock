<UserControl x:Class="mobileclock::ui::controls::AlarmActionsMenu"
             xmlns="urn:mobileclock:xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid id="alarmActionsHost"
          verticalAlignment="Stretch"
          horizontalAlignment="Stretch">
        <Border id="alarmActionsPanel"
                height="60"
                margin="0 0 0 100"
                verticalAlignment="Bottom"
                horizontalAlignment="Stretch"
                background="#00000000"
                cornerRadius="30">
            <Grid verticalAlignment="Stretch"
                  horizontalAlignment="Stretch">
                <rowDefinitions>
                    <rowDefinition height="Auto"/>
                    <rowDefinition height="*"/>
                </rowDefinitions>
                <Button id="alarmActionsMenu"
                        gridRow="0"
                        verticalAlignment="Center"
                        horizontalAlignment="Center"
                        background="#00000000"
                        borderThickness="0"
                        command="{Binding OpenMenuCommand}">
                    <SvgImage width="150"
                              height="60"
                              verticalAlignment="Center"
                              horizontalAlignment="Center"
                              source="Icons/more-horizontal.svg"
                              tint="#DDB54F"/>
                </Button>
                <Grid id="alarmActionsContent"
                      gridRow="1"
                      margin="20 20 0 0"
                      verticalAlignment="Stretch"
                      horizontalAlignment="Stretch">
                    <rowDefinitions>
                        <rowDefinition height="25"/>
                        <rowDefinition height="20"/>
                        <rowDefinition height="108"/>
                        <rowDefinition height="20"/>
                        <rowDefinition height="35"/>
                        <rowDefinition height="78"/>
                        <rowDefinition height="Auto"/>
                        <rowDefinition height="*"/>
                    </rowDefinitions>
                    <Border gridRow="0"
                            verticalAlignment="Stretch"
                            horizontalAlignment="Stretch">
                        <Grid verticalAlignment="Stretch"
                              horizontalAlignment="Stretch">
                            <columnDefinitions>
                                <columnDefinition width="38"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="35"/>
                            </columnDefinitions>
                            <Border width="20"
                                    height="20"
                                    verticalAlignment="Center"
                                    horizontalAlignment="Left"
                                    background="#DDB54F"
                                    cornerRadius="10"/>
                            <TextBlock gridColumn="1"
                                       text="Служебные действия"
                                       fontSize="32"
                                       margin="0 0 4 0"
                                       verticalAlignment="Center"
                                       horizontalAlignment="Left"
                                       foreground="#DDB54F"/>
                            <SvgImage gridColumn="2"
                                      width="28"
                                      height="28"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/chevron-down.svg"
                                      tint="#DDB54F"/>
                        </Grid>
                    </Border>
                    <Border id="updateApplicationButton"
                            gridRow="2"
                            verticalAlignment="Stretch"
                            horizontalAlignment="Stretch"
                            command="{Binding UpdateApplicationCommand}"
                            renderer="rendererWave"
                            background="#24251C"
                            borderBrush="#323327"
                            borderThickness="1"
                            cornerRadius="13">
                        <Border.Storyboards>
                            <Storyboard trigger="PointerDown">
                                <Animation name="animationSoftPulse"
                                           from="0"
                                           to="1"
                                           duration="1000"
                                           easing="CubicOut"
                                           intensity="0.95"
                                           spread="1.5"
                                           fadeExponent="1.6"/>
                                <Animation name="animationWaveOpacity"
                                           from="0"
                                           to="1"
                                           duration="1"
                                           easing="Linear"/>
                            </Storyboard>
                            <Storyboard trigger="PointerUp">
                                <Animation name="animationWaveOpacity"
                                           from="Current"
                                           to="0"
                                           duration="280"
                                           easing="CubicOut"/>
                            </Storyboard>
                        </Border.Storyboards>
                        <Grid height="105"
                              verticalAlignment="Stretch"
                              horizontalAlignment="Stretch">
                            <columnDefinitions>
                                <columnDefinition width="8"/>
                                <columnDefinition width="108"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="65"/>
                            </columnDefinitions>
                            <Border width="8"
                                    verticalAlignment="Stretch"
                                    horizontalAlignment="Left"
                                    background="#DDB54F"
                                    cornerRadius="4"/>
                            <SvgImage gridColumn="1"
                                      width="48"
                                      height="48"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/refresh.svg"
                                      tint="#DDB54F"/>
                            <Grid gridColumn="2"
                                  height="70"
                                  verticalAlignment="Center"
                                  horizontalAlignment="Stretch">
                                <rowDefinitions>
                                    <rowDefinition height="35"/>
                                    <rowDefinition height="35"/>
                                </rowDefinitions>
                                <TextBlock gridRow="0"
                                           text="Обновить"
                                           fontSize="35"
                                           verticalAlignment="Center"
                                           horizontalAlignment="Left"
                                           foreground="#F1E8D2"/>
                                <TextBlock gridRow="1"
                                           text="Проверить данные и виджеты"
                                           fontSize="29"
                                           verticalAlignment="Center"
                                           horizontalAlignment="Left"
                                           foreground="#96947C"/>
                            </Grid>
                            <SvgImage gridColumn="3"
                                      width="34"
                                      height="34"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/chevron-right.svg"
                                      tint="#DDB54F"/>
                        </Grid>
                    </Border>
                    <TextBlock gridRow="4"
                               text="Резервное"
                               fontSize="28"
                               verticalAlignment="Center"
                               horizontalAlignment="Left"
                               foreground="#96947C"/>
                    <Border id="uploadScreenshotButton"
                            gridRow="5"
                            verticalAlignment="Stretch"
                            horizontalAlignment="Stretch"
                            command="{Binding UploadScreenshotCommand}"
                            renderer="rendererWave"
                            background="#22231B"
                            borderBrush="#38392C"
                            borderThickness="1"
                            cornerRadius="13">
                        <Border.Storyboards>
                            <Storyboard trigger="PointerDown">
                                <Animation name="animationSoftPulse"
                                           from="0"
                                           to="1"
                                           duration="1000"
                                           easing="CubicOut"
                                           intensity="0.75"
                                           spread="1.35"
                                           fadeExponent="1.8"/>
                                <Animation name="animationWaveOpacity"
                                           from="0"
                                           to="1"
                                           duration="1"
                                           easing="Linear"/>
                            </Storyboard>
                            <Storyboard trigger="PointerUp">
                                <Animation name="animationWaveOpacity"
                                           from="Current"
                                           to="0"
                                           duration="280"
                                           easing="CubicOut"/>
                            </Storyboard>
                        </Border.Storyboards>
                        <Grid height="75"
                              verticalAlignment="Stretch"
                              horizontalAlignment="Stretch">
                            <columnDefinitions>
                                <columnDefinition width="115"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="65"/>
                            </columnDefinitions>
                            <SvgImage width="46"
                                      height="46"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/google-drive.svg"
                                      tint="#83816A"/>
                            <TextBlock gridColumn="1"
                                       text="Сохранить скриншот"
                                       fontSize="31"
                                       verticalAlignment="Center"
                                       horizontalAlignment="Left"
                                       foreground="#D7D0B8"/>
                            <SvgImage gridColumn="2"
                                      width="34"
                                      height="34"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/chevron-right.svg"
                                      tint="#77745A"/>
                        </Grid>
                    </Border>
                    <Grid id="alarmActionsStatus"
                          gridRow="6"
                          margin="0 0 20 0"
                          verticalAlignment="Stretch"
                          horizontalAlignment="Stretch">
                        <columnDefinitions>
                            <columnDefinition width="18"/>
                            <columnDefinition width="*"/>
                        </columnDefinitions>
                        <TextBlock gridColumn="1"
                                   text="{Binding Status}"
                                   fontSize="32"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Left"
                                   foreground="#AAA78B"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup name="AlarmActionsPanelStates">
                <VisualState name="Collapsed">
                    <Setters>
                        <Setter targetName="alarmActionsMenu"
                                property="width"
                                value="Auto"/>
                        <Setter targetName="alarmActionsMenu"
                                property="horizontalAlignment"
                                value="Center"/>
                        <Setter targetName="alarmActionsPanel"
                                property="background"
                                value="#00000000"/>
                    </Setters>
                    <Storyboard>
                        <FloatAnimation targetName="alarmActionsMenu"
                                        property="height"
                                        from="Current"
                                        to="60"
                                        duration="500"
                                        easing="CubicOut"/>
                        <FloatAnimation targetName="alarmActionsPanel"
                                        property="height"
                                        from="Current"
                                        to="60"
                                        duration="500"
                                        easing="CubicOut"/>
                        <FloatAnimation targetName="alarmActionsContent"
                                        property="opacity"
                                        from="Current"
                                        to="0"
                                        duration="500"
                                        easing="CubicOut"/>
                    </Storyboard>
                </VisualState>
                <VisualState name="Expanded">
                    <Setters>
                        <Setter targetName="alarmActionsMenu"
                                property="width"
                                value="Auto"/>
                        <Setter targetName="alarmActionsMenu"
                                property="horizontalAlignment"
                                value="Stretch"/>
                        <Setter targetName="alarmActionsPanel"
                                property="background"
                                value="#20211A"/>
                    </Setters>
                    <Storyboard>
                        <FloatAnimation targetName="alarmActionsMenu"
                                        property="height"
                                        from="Current"
                                        to="60"
                                        duration="500"
                                        easing="CubicOut"/>
                        <FloatAnimation targetName="alarmActionsPanel"
                                        property="height"
                                        from="Current"
                                        to="425"
                                        duration="500"
                                        easing="CubicOut"/>
                        <FloatAnimation targetName="alarmActionsContent"
                                        property="opacity"
                                        from="Current"
                                        to="1"
                                        duration="500"
                                        easing="CubicOut"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>