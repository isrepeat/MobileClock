<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="urn:mobileclock:xaml"
      id="settingsPage"
      background="#1B1C17"
      padding="24 24 80 24">
    <Page.Storyboards>
        <Storyboard trigger="Show">
            <Animation name="animationPageTransition"
                       duration="240"
                       distance="1"
                       easing="CubicOut"/>
            <FloatAnimation property="opacity"
                            from="0"
                            to="1"
                            duration="180"
                            easing="CubicOut"/>
        </Storyboard>
        <Storyboard trigger="Hide">
            <Animation name="animationPageTransition"
                       duration="240"
                       distance="1"
                       easing="CubicOut"/>
            <FloatAnimation property="opacity"
                            from="Current"
                            to="0"
                            duration="180"
                            easing="CubicOut"/>
        </Storyboard>
    </Page.Storyboards>
    <StackPanel orientation="Vertical"
                horizontalAlignment="Stretch"
                verticalAlignment="Top">
        <Grid height="90"
              borderBrush="#4E4B3D"
              borderThickness="0 0 0 1"
              horizontalAlignment="Stretch">
            <columnDefinitions>
                <columnDefinition width="12%"/>
                <columnDefinition width="76%"/>
                <columnDefinition width="12%"/>
            </columnDefinitions>
            <Border id="backNavigation"
                    background="#292A23"
                    command="{Binding NavigateToMainCommand}"
                    cornerRadius="24"
                    padding="10"
                    horizontalAlignment="Center"
                    verticalAlignment="Center">
                <SvgImage source="Icons/back.svg"
                          tint="#EADCB5"
                          width="40"
                          height="40"
                          horizontalAlignment="Center"
                          verticalAlignment="Center"/>
            </Border>
            <TextBlock text="Настройки"
                       fontSize="40"
                       fontWeight="Bold"
                       foreground="#EADCB5"
                       horizontalAlignment="Center"
                       verticalAlignment="Center"
                       gridColumn="1"/>
        </Grid>
        <TextBlock text="Оформление"
                   fontSize="18"
                   fontWeight="Bold"
                   foreground="#9D9477"
                   margin="8 36 0 12"/>
        <Border background="#292A23"
                borderBrush="#4E4B3D"
                borderThickness="1"
                cornerRadius="16"
                padding="24"
                horizontalAlignment="Stretch">
            <Grid height="72"
                  horizontalAlignment="Stretch">
                <columnDefinitions>
                    <columnDefinition width="40%"/>
                    <columnDefinition width="60%"/>
                </columnDefinitions>
                <TextBlock text="Тема"
                           fontSize="24"
                           foreground="#EADCB5"
                           horizontalAlignment="Left"
                           verticalAlignment="Center"/>
                <TextBlock text="{Binding Theme}"
                           fontSize="20"
                           foreground="#D5BD7D"
                           horizontalAlignment="Right"
                           verticalAlignment="Center"
                           gridColumn="1"/>
            </Grid>
        </Border>
        <TextBlock text="Будильники"
                   fontSize="18"
                   fontWeight="Bold"
                   foreground="#9D9477"
                   margin="8 36 0 12"/>
        <Border background="#292A23"
                borderBrush="#4E4B3D"
                borderThickness="1"
                cornerRadius="16"
                padding="24"
                horizontalAlignment="Stretch">
            <Grid height="72"
                  horizontalAlignment="Stretch">
                <columnDefinitions>
                    <columnDefinition width="40%"/>
                    <columnDefinition width="60%"/>
                </columnDefinitions>
                <TextBlock text="Звук"
                           fontSize="24"
                           foreground="#EADCB5"
                           horizontalAlignment="Left"
                           verticalAlignment="Center"/>
                <TextBlock text="{Binding Sound}"
                           fontSize="20"
                           foreground="#D5BD7D"
                           horizontalAlignment="Right"
                           verticalAlignment="Center"
                           gridColumn="1"/>
            </Grid>
        </Border>
        <Button renderer="rendererWave"
                id="shareLogsButton"
                text="Поделиться логом"
                command="{Binding ShareLogsCommand}"
                background="#303128"
                borderBrush="#47483D"
                borderThickness="1"
                foreground="#F1E8D2"
                cornerRadius="16"
                fontSize="24"
                fontWeight="Bold"
                height="72"
                margin="0 0 0 10"
                contentAlignment="Center"
                horizontalAlignment="Stretch">
            <Button.Storyboards>
                <Storyboard trigger="PointerDown">
                    <Animation name="animationSoftPulse"
                               from="0"
                               to="1"
                               duration="1000"
                               easing="CubicOut"
                               intensity="0.95"
                               spread="1.5"
                               fadeExponent="1.6"/>
                    <Animation name="animationWaveOpacity"
                               from="0"
                               to="1"
                               duration="1"
                               easing="Linear"/>
                </Storyboard>
                <Storyboard trigger="PointerUp">
                    <Animation name="animationWaveOpacity"
                               from="Current"
                               to="0"
                               duration="280"
                               easing="CubicOut"/>
                </Storyboard>
            </Button.Storyboards>
        </Button>
        <Button renderer="rendererWave"
                id="exportLogsButton"
                text="Экспортировать логи"
                command="{Binding ExportLogsCommand}"
                background="#303128"
                borderBrush="#47483D"
                borderThickness="1"
                foreground="#F1E8D2"
                cornerRadius="16"
                fontSize="24"
                fontWeight="Bold"
                height="72"
                margin="0 0 0 10"
                contentAlignment="Center"
                horizontalAlignment="Stretch">
            <Button.Storyboards>
                <Storyboard trigger="PointerDown">
                    <Animation name="animationSoftPulse"
                               from="0"
                               to="1"
                               duration="1000"
                               easing="CubicOut"
                               intensity="0.95"
                               spread="1.5"
                               fadeExponent="1.6"/>
                    <Animation name="animationWaveOpacity"
                               from="0"
                               to="1"
                               duration="1"
                               easing="Linear"/>
                </Storyboard>
                <Storyboard trigger="PointerUp">
                    <Animation name="animationWaveOpacity"
                               from="Current"
                               to="0"
                               duration="280"
                               easing="CubicOut"/>
                </Storyboard>
            </Button.Storyboards>
        </Button>
    </StackPanel>
</Page>