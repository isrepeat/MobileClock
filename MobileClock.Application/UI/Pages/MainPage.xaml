<?xml version="1.0" encoding="utf-8"?>
<?mobileclock-preview-scenario path="Scenarios/MainPage.json"?>
<Page id="root"
      padding="0 0 0 0"
      background="#171813"
      borderThickness="0"
      xmlns="urn:mobileclock:xaml"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:mobileclock.ui.controls">
    <Page.Storyboards>
        <Storyboard trigger="Show">
            <Animation name="animationPageTransition"
                       duration="240"
                       distance="1"
                       easing="CubicOut"/>
            <FloatAnimation property="opacity"
                            from="0"
                            to="1"
                            duration="180"
                            easing="CubicOut"/>
        </Storyboard>
        <Storyboard trigger="Hide">
            <Animation name="animationPageTransition"
                       duration="240"
                       distance="1"
                       easing="CubicOut"/>
            <FloatAnimation property="opacity"
                            from="Current"
                            to="0"
                            duration="180"
                            easing="CubicOut"/>
        </Storyboard>
    </Page.Storyboards>
    <Grid id="alarmTimelinePage"
          verticalAlignment="Stretch"
          horizontalAlignment="Stretch">
        <Border verticalAlignment="Stretch"
                horizontalAlignment="Stretch"
                background="#171813"
                cornerRadius="8"
                borderBrush="#24251D"
                borderThickness="1"/>
        <Grid id="timelineHost"
              verticalAlignment="Stretch"
              horizontalAlignment="Stretch">
            <Grid id="timelineContent"
                  margin="40 40 70 70"
                  verticalAlignment="Stretch"
                  horizontalAlignment="Stretch">
                <Grid id="timelineLayout"
                      verticalAlignment="Stretch"
                      horizontalAlignment="Stretch">
                    <rowDefinitions>
                        <rowDefinition height="7%"/>
                        <rowDefinition height="3%"/>
                        <rowDefinition height="*"/>
                        <rowDefinition height="20%"/>
                    </rowDefinitions>
                    <Grid id="timelineToolbar"
                          gridRow="0"
                          margin="0 0 35 0"
                          verticalAlignment="Top"
                          horizontalAlignment="Stretch">
                        <columnDefinitions>
                            <columnDefinition width="5%"/>
                            <columnDefinition width="Auto"/>
                            <columnDefinition width="*"/>
                            <columnDefinition width="Auto"/>
                            <columnDefinition width="0%"/>
                        </columnDefinitions>
                        <Button id="timelineMenuIcon"
                                gridColumn="1"
                                width="60"
                                height="60"
                                padding="0"
                                verticalAlignment="Center"
                                contentAlignment="Center"
                                horizontalAlignment="Left"
                                background="#00000000"
                                borderThickness="0">
                            <SvgImage width="40"
                                      height="40"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/menu.svg"
                                      tint="#8A8567"/>
                        </Button>
                        <Button id="timelineMoreIcon"
                                gridColumn="3"
                                width="60"
                                height="60"
                                padding="0"
                                verticalAlignment="Center"
                                contentAlignment="Center"
                                horizontalAlignment="Right"
                                background="#00000000"
                                command="{Binding NavigateToSettingsCommand}"
                                borderThickness="0">
                            <SvgImage width="40"
                                      height="40"
                                      verticalAlignment="Center"
                                      horizontalAlignment="Center"
                                      source="Icons/more-vertical.svg"
                                      tint="#8A8567"/>
                        </Button>
                    </Grid>
                    <controls:TimelineTabs gridRow="1"
                                           margin="200 0 8 0"
                                           verticalAlignment="Top"
                                           horizontalAlignment="Left"
                                           />
                    <Grid id="alarmTimeline"
                          gridRow="2"
                          margin="0 25 12 0"
                          verticalAlignment="Stretch"
                          horizontalAlignment="Stretch">
                        <Border width="4"
                                margin="150 0 0 0"
                                verticalAlignment="Stretch"
                                horizontalAlignment="Left"
                                background="#DDB54F"/>
                        <controls:InteractiveList verticalAlignment="Stretch"
                                                  horizontalAlignment="Stretch"
                                                  itemsSource="{Binding Alarms}"/>
                    </Grid>
                    <Grid id="timelineFooter"
                          gridRow="3"
                          verticalAlignment="Stretch"
                          horizontalAlignment="Stretch">
                        <columnDefinitions>
                            <columnDefinition width="112"/>
                            <columnDefinition width="80"/>
                            <columnDefinition width="*"/>
                        </columnDefinitions>
                        <StackPanel id="timelineTail"
                                    gridColumn="1"
                                    verticalAlignment="Top"
                                    horizontalAlignment="Center"
                                    orientation="Vertical">
                            <Border width="4"
                                    height="8"
                                    margin="0 0 8 0"
                                    horizontalAlignment="Center"
                                    background="#797047"
                                    cornerRadius="2"/>
                            <Border width="4"
                                    height="8"
                                    margin="0 0 8 0"
                                    horizontalAlignment="Center"
                                    background="#625E3D"
                                    cornerRadius="2"/>
                            <Border width="4"
                                    height="8"
                                    margin="0 0 8 0"
                                    horizontalAlignment="Center"
                                    background="#514F35"
                                    cornerRadius="2"/>
                            <Border width="4"
                                    height="8"
                                    margin="0 0 8 0"
                                    horizontalAlignment="Center"
                                    background="#43452F"
                                    cornerRadius="2"/>
                            <Border id="timelineEnd"
                                    width="32"
                                    height="32"
                                    margin="0 0 16 0"
                                    background="#171813"
                                    cornerRadius="16"
                                    borderThickness="5"
                                    borderBrush="#494B33"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid id="addAlarmContainer"
                      width="124"
                      height="124"
                      margin="0 40 0 150"
                      verticalAlignment="Bottom"
                      horizontalAlignment="Right">
                    <Border id="addAlarmButton"
                            verticalAlignment="Stretch"
                            horizontalAlignment="Stretch"
                            background="#E0B64D"
                            cornerRadius="62"
                            command="{Binding CreateAlarmCommand}"/>
                    <SvgImage id="addAlarmIcon"
                              width="52"
                              height="52"
                              verticalAlignment="Center"
                              horizontalAlignment="Center"
                              source="Icons/add.svg"
                              tint="#171813"/>
                </Grid>
            </Grid>
            <controls:AlarmActionsMenu id="alarmActionsMenuControl"
                                       verticalAlignment="Bottom"
                                       horizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Page>