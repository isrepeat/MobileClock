<?xml version="1.0" encoding="utf-8"?>
<Page id="addAlarmPage"
      padding="32"
      background="#171813"
      xmlns="urn:mobileclock:xaml">
    <Page.Storyboards>
        <Storyboard trigger="Show">
            <Animation name="animationPageTransition"
                       duration="240"
                       distance="1"
                       easing="CubicOut"/>
            <FloatAnimation property="opacity"
                            from="0"
                            to="1"
                            duration="180"
                            easing="CubicOut"/>
        </Storyboard>
        <Storyboard trigger="Hide">
            <Animation name="animationPageTransition"
                       duration="240"
                       distance="1"
                       easing="CubicOut"/>
            <FloatAnimation property="opacity"
                            from="Current"
                            to="0"
                            duration="180"
                            easing="CubicOut"/>
        </Storyboard>
    </Page.Storyboards>
    <Grid verticalAlignment="Stretch"
          horizontalAlignment="Stretch">
        <rowDefinitions>
            <rowDefinition height="84"/>
            <rowDefinition height="*"/>
            <rowDefinition height="108"/>
        </rowDefinitions>
        <Grid gridRow="0"
              horizontalAlignment="Stretch">
            <columnDefinitions>
                <columnDefinition width="72"/>
                <columnDefinition width="*"/>
            </columnDefinitions>
            <Button id="backNavigation"
                    width="64"
                    height="64"
                    padding="12"
                    verticalAlignment="Center"
                    background="#00000000"
                    borderThickness="0">
                <SvgImage width="40"
                          height="40"
                          source="Icons/back.svg"
                          tint="#EAE8DC"/>
            </Button>
            <TextBlock gridColumn="1"
                       verticalAlignment="Center"
                       fontSize="38"
                       fontWeight="Bold"
                       foreground="#EAE8DC"
                       text="Новый будильник"/>
        </Grid>
        <ScrollViewer id="formScrollViewer"
                      gridRow="1"
                      verticalAlignment="Stretch"
                      horizontalAlignment="Stretch"
                      verticalScrollBarVisibility="Hidden">
            <StackPanel horizontalAlignment="Stretch"
                        orientation="Vertical">
                <Grid id="timePicker"
                      height="360"
                      margin="0 0 12 0"
                      horizontalAlignment="Stretch">
                    <columnDefinitions>
                        <columnDefinition width="*"/>
                        <columnDefinition width="48"/>
                        <columnDefinition width="*"/>
                    </columnDefinitions>
                    <Grid id="wheel0"
                          gridColumn="0"
                          verticalAlignment="Stretch"
                          horizontalAlignment="Stretch"
                          background="#171813">
                        <rowDefinitions>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                        </rowDefinitions>
                        <TextBlock id="wheel0Row0"
                                   gridRow="0"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="05"
                                   opacity="0.3"/>
                        <TextBlock id="wheel0Row1"
                                   gridRow="1"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="06"
                                   opacity="0.65"/>
                        <TextBlock id="wheel0Row2"
                                   gridRow="2"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="100"
                                   fontWeight="Bold"
                                   foreground="#E0B64D"
                                   text="07"
                                   opacity="1"/>
                        <TextBlock id="wheel0Row3"
                                   gridRow="3"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="08"
                                   opacity="0.65"/>
                        <TextBlock id="wheel0Row4"
                                   gridRow="4"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="09"
                                   opacity="0.3"/>
                    </Grid>
                    <Grid id="wheel1"
                          gridColumn="2"
                          verticalAlignment="Stretch"
                          horizontalAlignment="Stretch"
                          background="#171813">
                        <rowDefinitions>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                            <rowDefinition height="*"/>
                        </rowDefinitions>
                        <TextBlock id="wheel1Row0"
                                   gridRow="0"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="28"
                                   opacity="0.3"/>
                        <TextBlock id="wheel1Row1"
                                   gridRow="1"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="29"
                                   opacity="0.65"/>
                        <TextBlock id="wheel1Row2"
                                   gridRow="2"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="100"
                                   fontWeight="Bold"
                                   foreground="#E0B64D"
                                   text="30"
                                   opacity="1"/>
                        <TextBlock id="wheel1Row3"
                                   gridRow="3"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="31"
                                   opacity="0.65"/>
                        <TextBlock id="wheel1Row4"
                                   gridRow="4"
                                   verticalAlignment="Center"
                                   horizontalAlignment="Center"
                                   fontSize="48"
                                   fontWeight="Normal"
                                   foreground="#93937E"
                                   text="32"
                                   opacity="0.3"/>
                    </Grid>
                    <TextBlock gridColumn="1"
                               verticalAlignment="Center"
                               horizontalAlignment="Center"
                               fontSize="92"
                               foreground="#E0B64D"
                               text=":"/>
                </Grid>
                <TextBlock margin="0 0 8 32"
                           horizontalAlignment="Center"
                           fontSize="24"
                           foreground="#93937E"
                           text="Время будильника"/>
                <Border padding="24"
                        horizontalAlignment="Stretch"
                        background="#23251C"
                        cornerRadius="24">
                    <StackPanel horizontalAlignment="Stretch"
                                orientation="Vertical">
                        <TextBlock fontSize="32"
                                   foreground="#EAE8DC"
                                   text="Дни недели"/>
                        <Grid height="68"
                              margin="0 0 20 12"
                              horizontalAlignment="Stretch">
                            <columnDefinitions>
                                <columnDefinition width="*"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="*"/>
                                <columnDefinition width="*"/>
                            </columnDefinitions>
                            <Button id="day0"
                                    gridColumn="0"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Пн"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                            <Button id="day1"
                                    gridColumn="1"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Вт"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                            <Button id="day2"
                                    gridColumn="2"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Ср"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                            <Button id="day3"
                                    gridColumn="3"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Чт"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                            <Button id="day4"
                                    gridColumn="4"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Пт"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                            <Button id="day5"
                                    gridColumn="5"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Сб"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                            <Button id="day6"
                                    gridColumn="6"
                                    margin="3 3 0 0"
                                    padding="0"
                                    verticalAlignment="Stretch"
                                    contentAlignment="Center"
                                    horizontalAlignment="Stretch"
                                    fontSize="24"
                                    foreground="#93937E"
                                    background="#23251C"
                                    cornerRadius="34"
                                    text="Вс"
                                    borderBrush="#62644F"
                                    borderThickness="1"/>
                        </Grid>
                        <TextBlock id="repeatSummary"
                                   fontSize="23"
                                   foreground="#93937E"
                                   text="По будням"/>
                    </StackPanel>
                </Border>
                <Border margin="0 0 20 0"
                        padding="24"
                        horizontalAlignment="Stretch"
                        background="#23251C"
                        cornerRadius="24">
                    <StackPanel horizontalAlignment="Stretch"
                                orientation="Vertical">
                        <Grid id="melodyButton"
                              height="84"
                              horizontalAlignment="Stretch"
                              background="#23251C">
                            <columnDefinitions>
                                <columnDefinition width="*"/>
                                <columnDefinition width="40"/>
                            </columnDefinitions>
                            <StackPanel verticalAlignment="Center"
                                        orientation="Vertical">
                                <TextBlock fontSize="32"
                                           foreground="#EAE8DC"
                                           text="Мелодия"/>
                                <TextBlock id="melodyName"
                                           margin="0 0 8 0"
                                           fontSize="24"
                                           foreground="#93937E"
                                           text="Рассвет"/>
                            </StackPanel>
                            <SvgImage gridColumn="1"
                                      width="32"
                                      height="32"
                                      verticalAlignment="Center"
                                      source="Icons/chevron-right.svg"
                                      tint="#93937E"/>
                        </Grid>
                        <StackPanel id="melodyChoices"
                                    horizontalAlignment="Stretch"
                                    visibility="Collapsed"
                                    orientation="Vertical"/>
                    </StackPanel>
                </Border>
                <Border height="112"
                        margin="0 0 20 24"
                        padding="24"
                        horizontalAlignment="Stretch"
                        background="#23251C"
                        cornerRadius="24">
                    <Grid verticalAlignment="Stretch"
                          horizontalAlignment="Stretch">
                        <columnDefinitions>
                            <columnDefinition width="*"/>
                            <columnDefinition width="100"/>
                        </columnDefinitions>
                        <TextBlock verticalAlignment="Center"
                                   fontSize="32"
                                   foreground="#EAE8DC"
                                   text="Вибрация"/>
                        <ToggleSwitch id="vibrationToggle"
                                      gridColumn="1"
                                      width="88"
                                      height="48"
                                      verticalAlignment="Center"
                                      foreground="#EAE8DC"
                                      background="#E0B64D"
                                      isOn="True"
                                      borderBrush="#51533D"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Button id="saveAlarmButton"
                gridRow="2"
                margin="0 0 16 0"
                verticalAlignment="Stretch"
                contentAlignment="Center"
                horizontalAlignment="Stretch"
                fontSize="32"
                fontWeight="Bold"
                foreground="#171813"
                background="#E0B64D"
                cornerRadius="28"
                text="Сохранить"
                borderThickness="0"/>
    </Grid>
</Page>